# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/out/
# build cache only - not needed to run the app, and this repo ships the
# prebuilt .next output directly, so incremental-build cache is dead weight
/.next/cache/
/.next/dev/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite database
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Android app signing key - private, never commit
/keystore

# uploaded course materials - not committed, provisioned per-deployment
/storage/course-uploads/*
!/storage/course-uploads/.gitkeep
