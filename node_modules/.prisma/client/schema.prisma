generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                String    @id @default(cuid())
  title             String
  date              DateTime
  endDate           DateTime?
  time              String?
  branches          String    @map("branch")
  category          String
  responsiblePerson String?
  priority          String    @default("Normal")
  status            String    @default("Pending")
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Settings {
  id                 Int      @id @default(1)
  unitName           String   @default("Unit")
  defaultReminder    String   @default("None")
  weekStartsOn       String   @default("Monday")
  adminPasswordHash  String   @default("$2b$10$sqf9dgEam1i01I5JPYNcNOW2bRIjDKOUCGCqB1JkhwrwxND.GWqnS")
  clerkPasswordHash  String   @default("$2b$10$2IhIaIU1pxbHvQtwABOpfeLF7FWfrLKawREUmoX6lgDU3X740fz1q")
  viewerPasswordHash String   @default("$2b$10$IKxCowPAKDKdereqMV/qM.Do7QPv6cI7Ovw64AQUVMzi.XzdXkGWW")
  updatedAt          DateTime @updatedAt
}

// --- E Pre Course (course-prep platform) models below ---
// Namespaced separately from the Task Management models above; the two
// features share this database and Next.js app but have independent auth.

enum CourseCategory {
  OFFICER
  JCO
  OR
}

enum CourseAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

// Singleton row holding the fixed admin account's password - there is no
// participant account system, so this is the only credential in Course.
model CourseSettings {
  id                Int      @id @default(1)
  adminPasswordHash String
  updatedAt         DateTime @updatedAt
}

model Course {
  id          String         @id @default(cuid())
  title       String
  category    CourseCategory
  description String?
  order       Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  documents CourseDocument[]
  quizzes   CourseQuiz[]

  @@index([category])
}

model CourseDocument {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  storedFilePath String
  originalName   String
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime @default(now())

  @@index([courseId])
}

model CourseQuiz {
  id                  String   @id @default(cuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title               String
  timeLimitSeconds    Int
  questionsPerAttempt Int
  isPublished         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  questions CourseQuestion[]
  attempts  CourseQuizAttempt[]

  @@index([courseId])
}

model CourseQuestion {
  id                 String     @id @default(cuid())
  quizId             String
  quiz               CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text               String
  optionA            String
  optionB            String
  optionC            String
  optionD            String
  correctOptionIndex Int
  explanation        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([quizId])
}

model CourseQuizAttempt {
  id                       String              @id @default(cuid())
  quizId                   String
  quiz                     CourseQuiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  participantName          String
  participantServiceNumber String
  status                   CourseAttemptStatus @default(IN_PROGRESS)
  timeLimitSecondsSnapshot Int
  questionsSnapshot        String
  answers                  String?
  score                    Int?
  totalQuestions           Int
  startedAt                DateTime            @default(now())
  submittedAt              DateTime?

  @@index([quizId])
}

model CoursePushSubscription {
  id        String         @id @default(cuid())
  category  CourseCategory
  endpoint  String         @unique
  p256dh    String
  auth      String
  createdAt DateTime       @default(now())

  @@index([category])
}

// --- Vehicle Tracking System (VTS) models below ---
// Namespaced separately (Vts prefix) from Task Management and E Pre Course.
// Drivers and vehicles are independently registered with no permanent
// assignment between them - the link exists only for the life of a
// VtsMovement. Route points are temporary and deleted when a movement ends;
// the VtsMovement row itself is kept afterward as a lightweight summary.

enum VtsDriverStatus {
  ACTIVE
  DISABLED
}

enum VtsVehicleCategory {
  JEEP
  PICKUP
  THREE_TON
  OTHER
}

enum VtsVehicleStatus {
  ACTIVE
  DISABLED
}

enum VtsMovementStatus {
  ACTIVE
  ENDED
}

enum VtsAlertType {
  MOVEMENT_STARTED
  MOVEMENT_ENDED
  SPEED_EXCEEDED
  GPS_POOR
  NETWORK_LOST
  WEAK_SIGNAL
  OFFLINE
}

model VtsSettings {
  id                 Int      @id @default(1)
  adminPasswordHash  String
  driverPasswordHash String
  updatedAt          DateTime @updatedAt
}

model VtsDriver {
  id        String          @id @default(cuid())
  name      String
  serviceId String          @unique
  phone     String?
  status    VtsDriverStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  movements VtsMovement[]

  @@index([status])
}

model VtsVehicle {
  id                String             @id @default(cuid())
  baNumber          String             @unique
  category          VtsVehicleCategory
  model             String?
  fuelType          String?
  mileageKmPerLiter Float?
  maxSpeedKmh       Int?
  status            VtsVehicleStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  movements VtsMovement[]

  @@index([status])
  @@index([category])
}

model VtsCategoryMileage {
  category          VtsVehicleCategory @id
  mileageKmPerLiter Float
  maxSpeedKmh       Int?
  updatedAt         DateTime           @updatedAt
}

model VtsMovement {
  id                      String             @id @default(cuid())
  driverId                String
  driver                  VtsDriver          @relation(fields: [driverId], references: [id])
  driverNameSnapshot      String
  driverServiceIdSnapshot String
  vehicleId               String
  vehicle                 VtsVehicle         @relation(fields: [vehicleId], references: [id])
  baNumberSnapshot        String
  categorySnapshot        VtsVehicleCategory
  status                  VtsMovementStatus  @default(ACTIVE)

  destination         String
  purpose             String
  startingOdometerKm  Float?
  passengers          Int?
  expectedDurationMin Int?
  remarks             String?

  mileageUsedKmPerLiter Float
  maxSpeedKmh           Int?

  distanceKm         Float @default(0)
  estimatedOilLiters Float @default(0)

  lastLat      Float?
  lastLng      Float?
  lastAccuracy Float?
  lastSpeedKmh Float?
  lastHeading  Float?
  lastPingAt   DateTime?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  routePoints VtsRoutePoint[]
  alerts      VtsAlert[]

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
}

model VtsRoutePoint {
  id         String      @id @default(cuid())
  movementId String
  movement   VtsMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  speedKmh   Float?
  heading    Float?
  recordedAt DateTime    @default(now())

  @@index([movementId])
}

model VtsAlert {
  id         String       @id @default(cuid())
  type       VtsAlertType
  movementId String?
  movement   VtsMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  baNumber   String?
  driverName String?
  message    String
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([movementId])
}
