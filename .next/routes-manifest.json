      "routeKeys": {
        "nxtPcourseId": "nxtPcourseId"
      },
      "namedRegex": "^/course/admin/courses/(?<nxtPcourseId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/course/admin/courses/[courseId]/quizzes/[quizId]",
