generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                String    @id @default(cuid())
  title             String
  date              DateTime
  endDate           DateTime?
  time              String?
  branches          String    @map("branch")
  category          String
  responsiblePerson String?
  priority          String    @default("Normal")
  status            String    @default("Pending")
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Settings {
  id                 Int      @id @default(1)
  unitName           String   @default("Unit")
  defaultReminder    String   @default("None")
  weekStartsOn       String   @default("Monday")
  adminPasswordHash  String   @default("$2b$10$sqf9dgEam1i01I5JPYNcNOW2bRIjDKOUCGCqB1JkhwrwxND.GWqnS")
  clerkPasswordHash  String   @default("$2b$10$2IhIaIU1pxbHvQtwABOpfeLF7FWfrLKawREUmoX6lgDU3X740fz1q")
  viewerPasswordHash String   @default("$2b$10$IKxCowPAKDKdereqMV/qM.Do7QPv6cI7Ovw64AQUVMzi.XzdXkGWW")
  updatedAt          DateTime @updatedAt
}

// --- E Pre Course (course-prep platform) models below ---
// Namespaced separately from the Task Management models above; the two
// features share this database and Next.js app but have independent auth.

enum CourseRole {
  ADMIN
  PARTICIPANT
}

enum CourseCategory {
  OFFICER
  JCO
  OR
}

enum CourseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model CourseUser {
  id            String                @id @default(cuid())
  serviceNumber String                @unique
  passwordHash  String
  name          String
  rank          String?
  role          CourseRole            @default(PARTICIPANT)
  category      CourseCategory?
  status        CourseApprovalStatus  @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  uploadedDocuments CourseDocument[]       @relation("CourseUploadedBy")
  quizAttempts      CourseQuizAttempt[]
  pushSubscriptions CoursePushSubscription[]

  @@index([category])
  @@index([status])
}

model Course {
  id          String         @id @default(cuid())
  title       String
  category    CourseCategory
  description String?
  order       Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  documents CourseDocument[]
  quizzes   CourseQuiz[]

  @@index([category])
}

model CourseDocument {
  id             String     @id @default(cuid())
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  storedFilePath String
  originalName   String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     CourseUser @relation("CourseUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt     DateTime   @default(now())

  @@index([courseId])
}

model CourseQuiz {
  id                  String   @id @default(cuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title               String
  timeLimitSeconds    Int
  questionsPerAttempt Int
  isPublished         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  questions CourseQuestion[]
  attempts  CourseQuizAttempt[]

  @@index([courseId])
}

model CourseQuestion {
  id                 String     @id @default(cuid())
  quizId             String
  quiz               CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text               String
  optionA            String
  optionB            String
  optionC            String
  optionD            String
  correctOptionIndex Int
  explanation        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([quizId])
}

model CourseQuizAttempt {
  id                       String               @id @default(cuid())
  quizId                   String
  quiz                     CourseQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId                   String
  user                     CourseUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   CourseAttemptStatus  @default(IN_PROGRESS)
  timeLimitSecondsSnapshot Int
  questionsSnapshot        String
  answers                  String?
  score                    Int?
  totalQuestions           Int
  startedAt                DateTime             @default(now())
  submittedAt              DateTime?

  @@index([quizId])
  @@index([userId])
}

model CoursePushSubscription {
  id        String     @id @default(cuid())
  userId    String
  user      CourseUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String     @unique
  p256dh    String
  auth      String
  createdAt DateTime   @default(now())

  @@index([userId])
}
